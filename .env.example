# ==============================================================================
# PLANEJAFÁCIL — MODELO DE VARIÁVEIS DE AMBIENTE (FRONTEND CLIENT-SAFE)
# ==============================================================================
# ATENÇÃO: Apenas variáveis prefixadas com VITE_ são expostas ao navegador.
# NUNCA inclua a chave 'service_role' ou segredos de banco de dados neste arquivo.
# ==============================================================================

# Supabase URL do Projeto (Ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Chave Pública / Anon Key (Segura para uso no navegador com Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-token-here

# Ambiente de Execução da Aplicação ('development' | 'staging' | 'production')
# Em 'production', seletores manuais de loja e perfis de teste são ocultados da interface.
VITE_APP_ENV=production
